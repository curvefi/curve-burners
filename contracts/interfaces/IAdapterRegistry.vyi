"""
@title IAdapterRegistry
@author Curve Finance
@license MIT
@notice Read interface of the validator adapter catalog used by the dispatcher.
@dev The struct is the single-source contracts/burners/auction/adapter_types.vy
     AdapterConfig. adapter_id is the registry lookup key and is deliberately
     not duplicated inside AdapterConfig (deviation from the prompt's Solidity
     sketch): the dispatcher already resolves the config by the envelope's
     adapter_id, so an embedded copy could only disagree with its own key.
     authorization_mode is the closed adapter_types MODE_* enum: the auction
     maps it to canonical routers itself, so the registry can never introduce
     an arbitrary approval target. An unknown adapter_id returns the zeroed
     config (validator == empty(address)).
"""

from contracts.burners.auction import adapter_types


@external
@view
def get_adapter(_adapter_id: bytes4) -> adapter_types.AdapterConfig:
    ...
