"""
@title IDutchAuction
@author Curve Finance
@license MIT
@notice The Dutch auction core ABI: economics, lot windows, quotes, native
        takes, and the signed-order check settlement adapters delegate to.
@dev Time is plain timestamps throughout: a lot is its staging timestamp
     plus the snapshot, window(token) is the window it trades in, and every
     window is auction_length long.
     Quotes and takes are named after Yearn
     Auction's selectors (want/available/price/getAmountNeeded/take) so
     Yearn tooling can drive them; the Yearn-only views live in
     IYearnAuction. price() is a 1e18-precision quote over raw amounts (raw
     want per 1e18 raw sell units); getAmountNeeded() is the canonical
     payment quote.
"""

from ethereum.ercs import IERC20


# A staged lot: when it was staged (0 = never) and the balance snapshot. The
# window is window(token, staged_at); the curve is read live, so
# initial_amount only pins the unit price and caps what is available.
struct Lot:
    staged_at: uint256
    initial_amount: uint256


# Economics


@external
@view
def auction_length() -> uint256:
    ...


@external
@view
def want() -> IERC20:
    ...


@external
@view
def receiver() -> address:
    ...


@external
@view
def start_total() -> uint256:
    ...


@external
@view
def floor_total() -> uint256:
    ...


@external
@view
def step_duration() -> uint256:
    ...


# Lots and quotes


@external
@view
def lots(_token: IERC20) -> Lot:
    ...


@external
@view
def window(_token: address, _timestamp: uint256 = ...) -> (uint256, uint256):
    ...


@external
@view
def available(_from: address, _ts: uint256 = ...) -> uint256:
    ...


@external
@view
def price(_from: address, _ts: uint256 = ...) -> uint256:
    ...


@external
@view
def getAmountNeeded(
    _from: address, amountToTake: uint256 = ..., _ts: uint256 = ...
) -> uint256:
    ...


# Native settlement


@external
def take(
    _from: address,
    maxAmount: uint256 = ...,
    takerReceiver: address = ...,
    data: Bytes[...] = ...,
) -> uint256:
    ...


@external
def take_with_limits(
    _from: address,
    _max_amount: uint256,
    _min_amount: uint256,
    _max_payment: uint256,
    _receiver: address,
    _deadline: uint256,
    _data: Bytes[...],
) -> (uint256, uint256):
    ...


# Signed-order economics


@external
@view
def check_order(
    _sell_token: address,
    _buy_token: address,
    _receiver: address,
    _sell_amount: uint256,
    _min_buy_amount: uint256,
    _valid_to: uint256,
) -> bool:
    ...
