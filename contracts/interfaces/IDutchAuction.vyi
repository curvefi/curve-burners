"""
@title IDutchAuction
@author Curve Finance
@license MIT
@notice Minimal Dutch auction ABI: the Yearn Auction-compatible subset
        want/available/price/getAmountNeeded/take/isActive/auctionLength/
        auctions plus the lot record.
@dev Only these selectors from Yearn Auction (yearn/
     tokenized-strategy-periphery, src/Auctions/Auction.sol) are implemented.
     Vyper default arguments export every Yearn overload of them: the
     timestamped available/price/getAmountNeeded, the single-argument
     getAmountNeeded (everything available), and the shortened take forms
     (everything available, to the caller, no callback). price() is a
     Curve-style 1e18-precision quote over raw amounts (raw want per 1e18
     raw sell units), not Yearn's per-whole-token price; auctions() returns
     Yearn's record shape (kicked, scaler, initialAvailable) derived from
     the lot with scaler = 1 to match, so Yearn's
     `amount * scaler * price / 1e18` reproduces getAmountNeeded() up to
     rounding. getAmountNeeded() is the canonical payment quote. kicked is
     the lot window's start (possibly in the future for a lot staged ahead
     of its window, so Yearn readers must gate on isActive rather than
     subtract kicked from now), initialAvailable the snapshot. The rest of
     Yearn's surface —
     kick/kickable/kicked and the governance setters — is absent; Yearn
     tooling relying on it will not work unchanged. Yearn's code is
     AGPL-3.0: only the selectors and their intended semantics were copied,
     the implementation behind this interface is independent.
"""

from ethereum.ercs import IERC20


# Lot staged for one epoch. Time bounds are not part of the record: the
# auction's calendar publishes them per epoch, and the curve is read live, so
# initial_amount only pins the unit price and caps what is available.
struct Lot:
    epoch: uint256
    initial_amount: uint256


# Yearn Auction's record shape (its `auctions(address)` getter), derived from
# the lot on read.
struct AuctionInfo:
    kicked: uint64
    scaler: uint64
    initialAvailable: uint128


@external
@view
def want() -> IERC20:
    ...


@external
@view
def lots(_token: IERC20) -> Lot:
    ...


@external
@view
def isActive(_from: address) -> bool:
    ...


@external
@view
def auctionLength() -> uint256:
    ...


@external
@view
def auctions(_from: address) -> AuctionInfo:
    ...


@external
@view
def available(_from: address, _ts: uint256 = ...) -> uint256:
    ...


@external
@view
def price(_from: address, _ts: uint256 = ...) -> uint256:
    ...


@external
@view
def getAmountNeeded(
    _from: address, amountToTake: uint256 = ..., _ts: uint256 = ...
) -> uint256:
    ...


@external
def take(
    _from: address,
    maxAmount: uint256 = ...,
    takerReceiver: address = ...,
    data: Bytes[...] = ...,
) -> uint256:
    ...
