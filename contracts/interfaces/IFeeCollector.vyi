from contracts.utils import constants as c


# Bit values: SLEEP = 1, COLLECT = 2, EXCHANGE = 4, FORWARD = 8.
flag Epoch:
    SLEEP
    COLLECT
    EXCHANGE
    FORWARD


struct Transfer:
    coin: address
    to: address
    amount: uint256


@external
@view
def fee(_epoch: Epoch = ..., _timestamp: uint256 = ...) -> uint256:
    ...


@external
@view
def target() -> address:
    ...


@external
@view
def owner() -> address:
    ...


@external
@view
def emergency_owner() -> address:
    ...


@external
@view
def epoch_time_frame(_epoch: Epoch, _timestamp: uint256 = ...) -> (uint256, uint256):
    ...


@external
@view
def can_exchange(_coins: DynArray[address, c.MAX_COINS]) -> bool:
    ...


@external
def transfer(_transfers: DynArray[Transfer, c.MAX_COINS]):
    ...
