"""
@title IDutchAuctionBurner
@author Curve Finance
@license MIT
@notice Full external ABI of DutchAuctionBurner: the Yearn-compatible
        IDutchAuction subset plus the auction core, adapter router, roles, and
        FeeCollector integration surfaces.
@dev The burner `implements` this file, so every declaration is checked
     against the real surface at compile time; peer contracts (CowAdapter's
     publisher helper, the intent resolver) and tooling read the burner
     through it; the lot record is IDutchAuction.Lot, so nothing is
     mirrored. isValidSignature takes the adapter signature template
     `adapter ++ payload` (see the adapters module).
"""

from ethereum.ercs import IERC20

from contracts.interfaces import IAdapterRegistry, IDutchAuction
from contracts.utils import constants as c


# Auction core


@external
@view
def current_epoch() -> uint256:
    ...


@external
@view
def want() -> IERC20:
    ...


@external
@view
def receiver() -> address:
    ...


@external
@view
def start_total() -> uint256:
    ...


@external
@view
def floor_total() -> uint256:
    ...


@external
@view
def decay_factor_ray() -> uint256:
    ...


@external
@view
def step_duration() -> uint256:
    ...


@external
@view
def reconfigured_epoch() -> uint256:
    ...


@external
@view
def lots(_token: IERC20) -> IDutchAuction.Lot:
    ...


@external
@view
def isActive(_from: address) -> bool:
    ...


@external
@view
def auctionLength() -> uint256:
    ...


@external
@view
def auctions(_from: address) -> IDutchAuction.AuctionInfo:
    ...


@external
@view
def available(_from: address, _ts: uint256 = ...) -> uint256:
    ...


@external
@view
def price(_from: address, _ts: uint256 = ...) -> uint256:
    ...


@external
@view
def getAmountNeeded(
    _from: address, amountToTake: uint256 = ..., _ts: uint256 = ...
) -> uint256:
    ...


@external
@view
def check_order(
    _sell_token: address,
    _buy_token: address,
    _receiver: address,
    _sell_amount: uint256,
    _min_buy_amount: uint256,
    _valid_to: uint256,
) -> bool:
    ...


@external
def take(
    _from: address,
    maxAmount: uint256 = ...,
    takerReceiver: address = ...,
    data: Bytes[...] = ...,
) -> uint256:
    ...


@external
def take_with_limits(
    _from: address,
    _max_amount: uint256,
    _min_amount: uint256,
    _max_payment: uint256,
    _receiver: address,
    _deadline: uint256,
    _data: Bytes[...],
) -> (uint256, uint256):
    ...


# Adapter router


@external
@view
def registry() -> IAdapterRegistry:
    ...


@external
@view
def isValidSignature(_hash: bytes32, _signature: Bytes[...]) -> bytes4:
